{
  "name": "zelune",
  "version": "1.6.6",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Zelune — Figma-style Multi-Screen React Native Visual Canvas & AST Sync MCP Server for Google Antigravity",
  "homepage": "https://github.com/woodfur/antigravity-rn-canvas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodfur/antigravity-rn-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/woodfur/antigravity-rn-canvas/issues"
  },
  "keywords": [
    "zelune",
    "google-antigravity",
    "react-native",
    "expo",
    "visual-canvas",
    "ast",
    "mcp",
    "figma"
  ],
  "bin": {
    "zelune": "bin/cli.mjs",
    "antigravity-rn-canvas": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "mcp/server.mjs",
    "skills/",
    "rules/",
    "assets/",
    "plugin.json",
    "mcp_config.json",
    "socket.yml",
    "PRODUCT.md",
    "DESIGN.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "zelune": "node ./bin/cli.mjs",
    "canvas": "node ./bin/cli.mjs",
    "build": "vite build --mode development",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "mcp": "node ./bin/cli.mjs --mcp"
  },
  "dependencies": {
    "@babel/generator": "^7.25.0",
    "@babel/parser": "^7.25.0",
    "@babel/types": "^7.25.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "6.4.4",
    "vitest": "^2.1.2"
  }
}
